---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllNotes, searchHref, type Note } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getAllNotes();
  return notes.map((note) => ({
    params: { category: note.category, slug: note.slug },
    props: { note },
  }));
}

interface Props {
  note: Note;
}

const { note } = Astro.props;
const entry = await getEntry('notes', note.id);
if (!entry) throw new Error(`노트를 찾지 못했습니다: ${note.id}`);
const { Content } = await render(entry);

const listHref = searchHref({ category: note.category });
const description = note.source ? `${note.title} — ${note.source}` : note.title;
---

<BaseLayout title={note.title} description={description} type="article">
  <a class="backlink" href={listHref}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m15 18-6-6 6-6"></path>
    </svg>
    {note.categoryTitle}
  </a>

  <header class="note-header">
    <div class="note-card__top">
      <a class="badge badge--category" href={listHref}>{note.categoryTitle}</a>
      {
        note.isRead ? (
          <span class="badge badge--read"><span class="badge__dot" aria-hidden="true" />읽음</span>
        ) : (
          <span class="badge badge--unread"><span class="badge__dot" aria-hidden="true" />안 읽음</span>
        )
      }
    </div>

    <div class="note-title-row">
      <h1 class="note-title">{note.title}</h1>
      <button
        class="copy-button"
        type="button"
        data-copy-title={note.title}
        aria-label="제목 복사"
        title="제목 복사"
      >
        <svg class="copy-button__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="11" height="11" rx="2"></rect>
          <path d="M5 15V5a2 2 0 0 1 2-2h8"></path>
        </svg>
        <svg class="copy-button__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m5 13 4 4 10-10"></path>
        </svg>
      </button>
    </div>

    <div class="note-meta">
      {
        note.source && (
          <span class="note-meta__pair">
            <span class="note-meta__key">출처</span>
            <span class="note-meta__value">{note.source}</span>
          </span>
        )
      }
      {
        note.published && (
          <span class="note-meta__pair">
            <span class="note-meta__key">발행</span>
            <span class="note-meta__value">{note.published.label}</span>
          </span>
        )
      }
      {
        note.readAt && (
          <span class="note-meta__pair">
            <span class="note-meta__key">읽음</span>
            <span class="note-meta__value">{note.readAt.label}</span>
          </span>
        )
      }
    </div>

    {
      note.tags.length > 0 && (
        <div class="note-tags">
          {note.tags.map((tag) => (
            <a class="tag" href={searchHref({ tags: [tag] })}>
              {tag}
            </a>
          ))}
        </div>
      )
    }

    <div class="note-actions">
      {
        note.url && (
          <a class="button button--primary" href={note.url} target="_blank" rel="noopener noreferrer">
            원문 열기
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7M9 7h8v8"></path>
            </svg>
          </a>
        )
      }
      <a class="button" href={listHref}>목록으로</a>
    </div>
  </header>

  <article class="prose">
    <Content />
  </article>

  <footer class="note-footer">
    <span>mandooshelf · {note.categoryTitle}</span>
    <a class="backlink" style="margin:0" href={listHref}>← {note.categoryTitle} 목록으로</a>
  </footer>
</BaseLayout>

<script>
  const COPY_LABEL = '제목 복사';
  const COPIED_LABEL = '복사됨';

  document.querySelectorAll<HTMLButtonElement>('[data-copy-title]').forEach((button) => {
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      const title = button.dataset.copyTitle ?? '';
      if (!title) return;

      let copied = false;
      try {
        await navigator.clipboard.writeText(title);
        copied = true;
      } catch {
        // 클립보드 API가 막혔을 때(구형·비보안 컨텍스트) 예전 방식으로 대신한다.
        const holder = document.createElement('textarea');
        holder.value = title;
        holder.setAttribute('readonly', '');
        holder.style.position = 'fixed';
        holder.style.top = '-1000px';
        document.body.appendChild(holder);
        holder.select();
        try {
          copied = document.execCommand('copy');
        } catch {
          copied = false;
        }
        holder.remove();
      }

      if (!copied) return;
      button.classList.add('is-copied');
      button.setAttribute('aria-label', COPIED_LABEL);
      button.title = COPIED_LABEL;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.classList.remove('is-copied');
        button.setAttribute('aria-label', COPY_LABEL);
        button.title = COPY_LABEL;
      }, 1500);
    });
  });
</script>
