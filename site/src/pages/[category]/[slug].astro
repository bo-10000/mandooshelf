---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllNotes, searchHref, type Note } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getAllNotes();
  return notes.map((note) => ({
    params: { category: note.category, slug: note.slug },
    props: { note },
  }));
}

interface Props {
  note: Note;
}

const { note } = Astro.props;
const entry = await getEntry('notes', note.id);
if (!entry) throw new Error(`노트를 찾지 못했습니다: ${note.id}`);
const { Content, headings } = await render(entry);

/**
 * 파일 끝이 (주석·빈 줄만 남기고) 제목으로 끝나면 그 제목은 템플릿 자리라 본문에서 숨겨진다.
 * 숨은 제목으로는 이동할 수 없으니 목차에서도 뺀다.
 */
function trailingEmptyHeadingText(body: string): string | null {
  const stripped = body.replace(/<!--[\s\S]*?-->/g, '').trimEnd();
  const lastLine = stripped.split('\n').pop() ?? '';
  const matched = lastLine.trim().match(/^#{1,6}\s+(.+)$/);
  return matched ? matched[1].trim() : null;
}

/** h2부터 아래 단계까지, 빈 제목과 본문에서 숨는 템플릿 제목을 뺀 목차 항목. */
const toc = headings.filter((heading) => heading.depth >= 2 && heading.text.trim().length > 0);
const trailingEmptyText = trailingEmptyHeadingText(entry.body ?? '');
if (trailingEmptyText && toc.at(-1)?.text.trim() === trailingEmptyText) toc.pop();

const listHref = searchHref({ category: note.category });
const description = note.source ? `${note.title} — ${note.source}` : note.title;
---

<BaseLayout title={note.title} description={description} type="article" wide>
  <div class="note-page">
    <div class="note-page__main">
      <a class="backlink" href={listHref}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        {note.categoryTitle}
      </a>

      <header class="note-header">
        <div class="note-card__top">
          <a class="badge badge--category" href={listHref}>{note.categoryTitle}</a>
          {
            note.isRead ? (
              <span class="badge badge--read"><span class="badge__dot" aria-hidden="true" />읽음</span>
            ) : (
              <span class="badge badge--unread"><span class="badge__dot" aria-hidden="true" />안 읽음</span>
            )
          }
        </div>

        <div class="note-title-row">
          <h1 class="note-title">{note.title}</h1>
          <button
            class="copy-button"
            type="button"
            data-copy-title={note.title}
            aria-label="제목 복사"
            title="제목 복사"
          >
            <svg class="copy-button__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="11" height="11" rx="2"></rect>
              <path d="M5 15V5a2 2 0 0 1 2-2h8"></path>
            </svg>
            <svg class="copy-button__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m5 13 4 4 10-10"></path>
            </svg>
          </button>
        </div>

        <div class="note-meta">
          {
            note.source && (
              <span class="note-meta__pair">
                <span class="note-meta__key">출처</span>
                <span class="note-meta__value">{note.source}</span>
              </span>
            )
          }
          {
            note.published && (
              <span class="note-meta__pair">
                <span class="note-meta__key">발행</span>
                <span class="note-meta__value">{note.published.label}</span>
              </span>
            )
          }
          {
            note.readAt && (
              <span class="note-meta__pair">
                <span class="note-meta__key">읽음</span>
                <span class="note-meta__value">{note.readAt.label}</span>
              </span>
            )
          }
        </div>

        {
          note.tags.length > 0 && (
            <div class="note-tags">
              {note.tags.map((tag) => (
                <a class="tag" href={searchHref({ tags: [tag] })}>
                  {tag}
                </a>
              ))}
            </div>
          )
        }

        <div class="note-actions">
          {
            note.url && (
              <a class="button button--primary" href={note.url} target="_blank" rel="noopener noreferrer">
                원문 열기
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7M9 7h8v8"></path>
                </svg>
              </a>
            )
          }
          <a class="button" href={listHref}>목록으로</a>
        </div>
      </header>
    </div>

    {
      toc.length > 1 && (
        <nav class="note-toc" aria-label="목차">
          <button
            class="note-toc__toggle"
            type="button"
            aria-expanded="false"
            aria-controls="note-toc-list"
          >
            <span class="note-toc__toggle-title">목차</span>
            <span class="note-toc__count">{toc.length}</span>
            <svg class="note-toc__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>
          <p class="note-toc__label">목차</p>
          <ol class="note-toc__list" id="note-toc-list">
            {toc.map((heading) => (
              <li class:list={['note-toc__item', `note-toc__item--d${Math.min(heading.depth, 4)}`]}>
                <a class="note-toc__link" href={`#${heading.slug}`} data-toc-link>
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <article class="prose">
      <Content />
    </article>
  </div>
</BaseLayout>

<script>
  const COPY_LABEL = '제목 복사';
  const COPIED_LABEL = '복사됨';

  document.querySelectorAll<HTMLButtonElement>('[data-copy-title]').forEach((button) => {
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      const title = button.dataset.copyTitle ?? '';
      if (!title) return;

      let copied = false;
      try {
        await navigator.clipboard.writeText(title);
        copied = true;
      } catch {
        // 클립보드 API가 막혔을 때(구형·비보안 컨텍스트) 예전 방식으로 대신한다.
        const holder = document.createElement('textarea');
        holder.value = title;
        holder.setAttribute('readonly', '');
        holder.style.position = 'fixed';
        holder.style.top = '-1000px';
        document.body.appendChild(holder);
        holder.select();
        try {
          copied = document.execCommand('copy');
        } catch {
          copied = false;
        }
        holder.remove();
      }

      if (!copied) return;
      button.classList.add('is-copied');
      button.setAttribute('aria-label', COPIED_LABEL);
      button.title = COPIED_LABEL;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.classList.remove('is-copied');
        button.setAttribute('aria-label', COPY_LABEL);
        button.title = COPY_LABEL;
      }, 1500);
    });
  });

  // 좁은 화면에서는 목차를 접은 채로 시작해 머리를 누르면 펼친다(넓은 화면에서는 CSS가 늘 펼쳐 둔다).
  const tocNav = document.querySelector<HTMLElement>('.note-toc');
  const tocToggle = tocNav?.querySelector<HTMLButtonElement>('.note-toc__toggle') ?? null;
  const desktopQuery = window.matchMedia('(min-width: 1024px)');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SCROLL_OFFSET = 76; // 본문 제목의 scroll-margin-top과 같은 값.

  const setTocExpanded = (expanded: boolean) => {
    tocToggle?.setAttribute('aria-expanded', String(expanded));
  };

  if (tocToggle) {
    tocToggle.addEventListener('click', () => {
      setTocExpanded(tocToggle.getAttribute('aria-expanded') !== 'true');
    });

    // 화면 폭이 바뀌면 넓은 화면은 늘 펼침, 좁은 화면은 다시 접힘으로 맞춘다.
    desktopQuery.addEventListener('change', (event) => setTocExpanded(event.matches));
  }

  // 지금 읽고 있는 구역을 목차에서 표시한다.
  const tocLinks = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.note-toc [data-toc-link]').forEach((link) => {
    const href = link.getAttribute('href') ?? '';
    if (!href.startsWith('#')) return;
    tocLinks.set(href.slice(1), link);
  });

  if (tocLinks.size > 0) {
    const headings = Array.from(
      document.querySelectorAll<HTMLElement>('.prose :is(h2, h3, h4, h5, h6)[id]'),
    ).filter((heading) => tocLinks.has(heading.id));

    if (headings.length > 0) {
      const ACTIVE_LINE = 96; // 상단 헤더(56px) 아래 이 높이를 지난 제목을 '보고 있는 구역'으로 본다.
      let activeId: string | null = null;

      // 사이드바가 화면보다 길어 안에서 스크롤될 때, 표시한 항목이 보이게 맞춘다.
      const revealLink = (link: HTMLAnchorElement) => {
        if (!tocNav || tocNav.scrollHeight <= tocNav.clientHeight + 2) return;
        const linkBox = link.getBoundingClientRect();
        const navBox = tocNav.getBoundingClientRect();
        if (linkBox.top < navBox.top) tocNav.scrollTop += linkBox.top - navBox.top - 8;
        else if (linkBox.bottom > navBox.bottom) tocNav.scrollTop += linkBox.bottom - navBox.bottom + 8;
      };

      const setActive = (id: string | null) => {
        if (id === activeId) return;
        if (activeId) {
          const previous = tocLinks.get(activeId);
          previous?.classList.remove('is-active');
          previous?.removeAttribute('aria-current');
        }
        activeId = id;
        const next = id ? tocLinks.get(id) : null;
        if (next) {
          next.classList.add('is-active');
          next.setAttribute('aria-current', 'location');
          revealLink(next);
        }
      };

      const update = () => {
        let current = headings[0].id;
        for (const heading of headings) {
          if (heading.getBoundingClientRect().top - ACTIVE_LINE <= 0) current = heading.id;
          else break;
        }
        // 맨 아래까지 내려가면 마지막 구역을 표시한다.
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
          current = headings[headings.length - 1].id;
        }
        setActive(current);
      };

      // 제목이 화면 경계를 지날 때 바로 반영되도록 관찰자를 두고,
      // 긴 구역 안에서도 정확하도록 스크롤에서 한 번 더 계산한다.
      const observer = new IntersectionObserver(update, {
        rootMargin: `-${ACTIVE_LINE}px 0px -40% 0px`,
        threshold: 0,
      });
      headings.forEach((heading) => observer.observe(heading));

      let ticking = false;
      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          update();
        });
      };
      window.addEventListener('scroll', requestUpdate, { passive: true });
      window.addEventListener('resize', requestUpdate, { passive: true });

      tocLinks.forEach((link, id) => {
        link.addEventListener('click', (event) => {
          // 좁은 화면: 목차를 접어 본문을 보여 주고, 접힌 만큼 달라진 위치로 직접 이동한다.
          const target = !desktopQuery.matches ? document.getElementById(id) : null;
          if (target) {
            event.preventDefault();
            setTocExpanded(false);
            const top = target.getBoundingClientRect().top + window.scrollY - SCROLL_OFFSET;
            window.scrollTo({ top, behavior: reduceMotion ? 'auto' : 'smooth' });
            history.replaceState(null, '', `#${id}`);
          }
          setActive(id);
        });
      });

      update();
    }
  }
</script>
