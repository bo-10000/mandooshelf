---
/**
 * 카테고리별 목록은 `/search/?category=...` 로 통합됐다.
 * 예전 주소(/recommendation/, /ai-agent/)와 검색엔진·북마크 링크가 깨지지 않도록
 * 필터를 그대로 넘겨 주는 안내 페이지를 남긴다. (JS 없이도 meta refresh 로 이동)
 */
import { getCategories, searchHref, type CategorySummary } from '../../lib/notes';

export async function getStaticPaths() {
  const categories = await getCategories();
  return categories.map((category) => ({
    params: { category: category.id },
    props: { category },
  }));
}

interface Props {
  category: CategorySummary;
}

const { category } = Astro.props;
const target = searchHref({ category: category.id });
const targetUrl = new URL(target, Astro.site ?? 'https://bo-10000.github.io');
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{category.title} · mandooshelf</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={targetUrl} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ categoryId: category.id, fallback: target }}>
      // 예전 주소에 붙어 있던 필터(?status=, ?tag=, ?q=, ?sort=)를 통합 검색 주소로 옮긴다.
      (function () {
        try {
          var incoming = new URLSearchParams(window.location.search);
          var next = new URLSearchParams();
          next.set('category', categoryId);

          var status = incoming.get('status');
          if (status === 'read' || status === 'unread') next.set('status', status);

          var tags = incoming.get('tags') || incoming.get('tag');
          if (tags) next.set('tags', tags);

          var q = incoming.get('q');
          if (q) next.set('q', q);

          var sort = incoming.get('sort');
          if (sort) next.set('sort', sort);

          var path = fallback.split('?')[0];
          var search = next.toString();
          window.location.replace(path + (search ? '?' + search : ''));
        } catch (error) {
          window.location.replace(fallback);
        }
      })();
    </script>
  </head>
  <body>
    <p>
      <a href={target}>{category.title} 글 보기 →</a>
    </p>
  </body>
</html>
