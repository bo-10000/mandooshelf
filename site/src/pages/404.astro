---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href, searchHref } from '../lib/notes';
---

<BaseLayout title="페이지를 찾을 수 없습니다">
  <header class="page-head">
    <h1 class="page-head__title">페이지를 찾을 수 없습니다</h1>
    <div class="note-actions">
      <a class="button button--primary" href={href('/')}>홈으로</a>
      <a class="button" href={searchHref()}>전체 글 보기</a>
    </div>
  </header>
</BaseLayout>
