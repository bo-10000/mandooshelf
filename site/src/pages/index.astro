---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteList from '../components/NoteList.astro';
import { getAllNotes, getCategories, readCalendar, searchHref, sortByRead, totalSummary } from '../lib/notes';

const notes = await getAllNotes();
const categories = await getCategories();
const summary = totalSummary(notes);
const unread = notes.filter((note) => !note.isRead);
const unreadPreview = unread.slice(0, 3);
const recentRead = sortByRead(notes, 3);
const calendar = readCalendar(notes);
const calendarDays = calendar.weeks.flatMap((week) => week.days);
---

<BaseLayout>
  <header class="home-head">
    <h1 class="home-head__title">테크 아카이브</h1>
    <p class="home-head__desc">읽은 테크 블로그와 컨퍼런스 정리를 모아 둡니다.</p>
  </header>

  <p class="summary">
    <span><strong>{summary.total}</strong>전체</span>
    <span><strong class="summary__unread">{summary.unread}</strong>안 읽음</span>
    <span><strong>{summary.read}</strong>읽음</span>
  </p>

  <section class="section" aria-labelledby="category-title">
    <div class="section__head">
      <h2 class="section__title" id="category-title">카테고리</h2>
      <a class="section__more" href={searchHref()}>전체 글 보기 →</a>
    </div>
    <div class="category-grid">
      {
        categories.map((category) => {
          const percent = category.total === 0 ? 0 : Math.round((category.read / category.total) * 100);
          return (
            <a class="category-card" href={searchHref({ category: category.id })}>
              <div class="category-card__top">
                <h3 class="category-card__title">{category.title}</h3>
                <span class="category-card__count">
                  읽음 {category.read} / {category.total}
                </span>
              </div>
              <div class="progress" role="img" aria-label={`${percent}% 읽음`}>
                <span class="progress__bar" style={`width:${percent}%`} />
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="section" aria-labelledby="unread-title">
    <div class="section__head">
      <h2 class="section__title" id="unread-title">
        안 읽은 글 <span class="section__count">{unread.length}</span>
      </h2>
      <a class="section__more" href={searchHref({ status: 'unread' })}>
        더보기 →
      </a>
    </div>
    <NoteList notes={unreadPreview} showCategory emptyTitle="안 읽은 글 없음" />
  </section>

  <section class="section" aria-labelledby="recent-title">
    <div class="section__head">
      <h2 class="section__title" id="recent-title">
        최근 읽은 글 <span class="section__count">{summary.read}</span>
      </h2>
      <a class="section__more" href={searchHref({ status: 'read' })}>더보기 →</a>
    </div>
    <NoteList notes={recentRead} showCategory emptyTitle="읽은 글 없음" />
  </section>

  <section class="section" aria-labelledby="calendar-title">
    <div class="section__head">
      <h2 class="section__title" id="calendar-title">만두키우기</h2>
    </div>
    <div class="calendar">
      <div class="calendar__scroll">
        <div class="calendar__inner" style={`--weeks:${calendar.weeks.length}`}>
          <div class="calendar__months" aria-hidden="true">
            {
              calendar.months.map((month) => (
                <span class="calendar__month" style={`grid-column: ${month.index + 1} / span ${month.span}`}>
                  {month.label}
                </span>
              ))
            }
          </div>
          <div
            class="calendar__grid"
            role="group"
            aria-label={`${calendar.windowLabel} 동안 ${calendar.activeDays}일에 ${calendar.total}편 읽음`}
            data-calendar
          >
            {
              calendarDays.map((day) =>
                day.future ? (
                  <span class="calendar__cell calendar__cell--future" aria-hidden="true" />
                ) : (
                  <button
                    type="button"
                    tabindex="-1"
                    class={`calendar__cell calendar__cell--l${day.level}`}
                    data-date={day.date}
                    data-notes={day.count > 0 ? JSON.stringify(day.notes) : undefined}
                    aria-haspopup="dialog"
                    aria-expanded="false"
                    aria-label={`${day.date} · ${day.count > 0 ? `${day.count}편 읽음` : '읽은 글 없음'}`}
                  >
                    {day.count > 0 && <span class="calendar__dumpling" aria-hidden="true">🥟</span>}
                  </button>
                ),
              )
            }
          </div>
        </div>
      </div>
    </div>

    <div class="calendar-sheet" data-calendar-sheet hidden>
      <div class="calendar-sheet__backdrop" data-calendar-sheet-close></div>
      <div
        class="calendar-sheet__panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="calendar-sheet-title"
        data-calendar-sheet-panel
      >
        <span class="calendar-sheet__handle" aria-hidden="true"></span>
        <div class="calendar-sheet__head">
          <h3 class="calendar-sheet__title" id="calendar-sheet-title" data-calendar-sheet-title></h3>
          <button
            type="button"
            class="calendar-sheet__close"
            aria-label="닫기"
            data-calendar-sheet-close
          >
            ×
          </button>
        </div>
        <ul class="calendar-sheet__list" data-calendar-sheet-list></ul>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const grid = document.querySelector<HTMLElement>('[data-calendar]');
  const scroller = grid?.closest<HTMLElement>('.calendar__scroll');

  // 좁은 화면에서는 처음 열 때 최근 날짜(오른쪽 끝)가 보이게 맞춘다.
  // iOS Safari는 첫 레이아웃·웹폰트가 끝나기 전에 넣은 scrollLeft를 0으로 되돌리고,
  // bfcache로 돌아올 때도 위치를 복원하므로 여러 시점에 다시 맞춘다.
  if (scroller) {
    let userMoved = false;
    const markMoved = () => {
      userMoved = true;
    };
    (['pointerdown', 'touchstart', 'wheel', 'keydown'] as const).forEach((type) => {
      scroller.addEventListener(type, markMoved, { passive: true });
    });

    const scrollCalendarToLatest = () => {
      if (userMoved) return;
      // scroll-behavior: auto 라서 애니메이션 없이 바로 오른쪽 끝으로 간다.
      scroller.scrollLeft = Math.max(0, scroller.scrollWidth - scroller.clientWidth);
    };

    const pinCalendar = () => {
      requestAnimationFrame(() => {
        scrollCalendarToLatest();
        // 레이아웃이 한 번 더 바뀌는 브라우저(iOS 주소창·폰트)를 위해 한 프레임 더.
        requestAnimationFrame(scrollCalendarToLatest);
      });
    };

    pinCalendar();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', pinCalendar);
    }
    window.addEventListener('load', pinCalendar);
    window.addEventListener('pageshow', pinCalendar);
    document.fonts?.ready.then(pinCalendar);
    window.setTimeout(pinCalendar, 300);
    window.setTimeout(pinCalendar, 1000);
  }

  // 날짜를 누르면 그날 읽은 글이 뜬다. 모바일은 바텀시트, 넓은 화면은 가운데 모달.
  const sheet = document.querySelector<HTMLElement>('[data-calendar-sheet]');
  const sheetTitle = sheet?.querySelector<HTMLElement>('[data-calendar-sheet-title]');
  const sheetList = sheet?.querySelector<HTMLElement>('[data-calendar-sheet-list]');
  const sheetClose = sheet?.querySelector<HTMLButtonElement>('.calendar-sheet__close');
  let activeCell: HTMLElement | null = null;

  const formatDay = (iso: string) => iso.replace(/-/g, '.');

  const closeSheet = () => {
    if (!sheet || sheet.hidden) return;
    sheet.hidden = true;
    activeCell?.classList.remove('is-active');
    activeCell?.setAttribute('aria-expanded', 'false');
    activeCell?.focus({ preventScroll: true });
    activeCell = null;
  };

  const openSheet = (cell: HTMLElement) => {
    if (!sheet || !sheetTitle || !sheetList || !cell.dataset.date) return;
    interface SheetNote {
      title: string;
      href: string;
      categoryTitle?: string;
      source?: string;
      date?: string;
    }
    const dayNotes = JSON.parse(cell.dataset.notes || '[]') as SheetNote[];

    sheetTitle.textContent = `${formatDay(cell.dataset.date)} - ${dayNotes.length}편`;
    sheetList.replaceChildren();

    if (dayNotes.length === 0) {
      const empty = document.createElement('li');
      empty.className = 'calendar-sheet__empty';
      empty.textContent = '그날은 읽은 글이 없어요.';
      sheetList.append(empty);
    } else {
      // 카드 한 장 = 카테고리 뱃지 + 제목(한 줄) 아래 출처 · 발행일.
      dayNotes.forEach((note) => {
        const item = document.createElement('li');
        item.className = 'calendar-sheet__item';

        const link = document.createElement('a');
        link.className = 'calendar-sheet__card';
        link.href = note.href;

        const top = document.createElement('span');
        top.className = 'calendar-sheet__card-top';

        if (note.categoryTitle) {
          const category = document.createElement('span');
          category.className = 'badge badge--category';
          category.textContent = note.categoryTitle;
          top.append(category);
        }

        const title = document.createElement('span');
        title.className = 'calendar-sheet__card-title';
        title.textContent = note.title;
        top.append(title);
        link.append(top);

        const metaParts = [note.source, note.date].filter((part): part is string => !!part);
        if (metaParts.length > 0) {
          const meta = document.createElement('span');
          meta.className = 'calendar-sheet__card-meta';
          metaParts.forEach((part, index) => {
            if (index > 0) {
              const dot = document.createElement('span');
              dot.className = 'dot';
              dot.setAttribute('aria-hidden', 'true');
              meta.append(dot);
            }
            const value = document.createElement('span');
            value.textContent = part;
            meta.append(value);
          });
          link.append(meta);
        }

        item.append(link);
        sheetList.append(item);
      });
    }

    sheet.hidden = false;
    cell.setAttribute('aria-expanded', 'true');
    sheetClose?.focus({ preventScroll: true });
  };

  if (grid) {
    grid.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const cell = target?.closest<HTMLElement>('[data-date]');
      if (!cell) return;

      // 같은 칸을 다시 누르면 닫는다.
      if (cell === activeCell) {
        closeSheet();
        return;
      }

      grid.querySelectorAll('.is-active').forEach((element) => element.classList.remove('is-active'));
      activeCell?.setAttribute('aria-expanded', 'false');
      cell.classList.add('is-active');
      activeCell = cell;
      openSheet(cell);
    });
  }

  sheet?.querySelectorAll('[data-calendar-sheet-close]').forEach((element) => {
    element.addEventListener('click', closeSheet);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && sheet && !sheet.hidden) closeSheet();
  });
</script>
