---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteList from '../components/NoteList.astro';
import { getAllNotes, getCategories, readCalendar, searchHref, sortByRead, totalSummary } from '../lib/notes';

const notes = await getAllNotes();
const categories = await getCategories();
const summary = totalSummary(notes);
const unread = notes.filter((note) => !note.isRead);
const unreadPreview = unread.slice(0, 3);
const recentRead = sortByRead(notes, 3);
const calendar = readCalendar(notes);
const calendarDays = calendar.weeks.flatMap((week) => week.days);
---

<BaseLayout>
  <header class="home-head">
    <h1 class="home-head__title">테크 아카이브</h1>
    <p class="home-head__desc">읽은 테크 블로그와 컨퍼런스 정리를 모아 둡니다.</p>
  </header>

  <p class="summary">
    <span><strong>{summary.total}</strong>전체</span>
    <span><strong class="summary__unread">{summary.unread}</strong>안 읽음</span>
    <span><strong>{summary.read}</strong>읽음</span>
  </p>

  <section class="section" aria-labelledby="category-title">
    <div class="section__head">
      <h2 class="section__title" id="category-title">카테고리</h2>
      <a class="section__more" href={searchHref()}>전체 글 보기 →</a>
    </div>
    <div class="category-grid">
      {
        categories.map((category) => {
          const percent = category.total === 0 ? 0 : Math.round((category.read / category.total) * 100);
          return (
            <a class="category-card" href={searchHref({ category: category.id })}>
              <div class="category-card__top">
                <h3 class="category-card__title">{category.title}</h3>
                <span class="category-card__count">
                  읽음 {category.read} / {category.total}
                </span>
              </div>
              <div class="progress" role="img" aria-label={`${percent}% 읽음`}>
                <span class="progress__bar" style={`width:${percent}%`} />
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="section" aria-labelledby="unread-title">
    <div class="section__head">
      <h2 class="section__title" id="unread-title">
        안 읽은 글 <span class="section__count">{unread.length}</span>
      </h2>
      <a class="section__more" href={searchHref({ status: 'unread' })}>
        더보기 →
      </a>
    </div>
    <NoteList notes={unreadPreview} showCategory emptyTitle="안 읽은 글 없음" />
  </section>

  <section class="section" aria-labelledby="recent-title">
    <div class="section__head">
      <h2 class="section__title" id="recent-title">
        최근 읽은 글 <span class="section__count">{summary.read}</span>
      </h2>
      <a class="section__more" href={searchHref({ status: 'read' })}>더보기 →</a>
    </div>
    <NoteList notes={recentRead} showCategory emptyTitle="읽은 글 없음" />
  </section>

  <section class="section" aria-labelledby="calendar-title">
    <div class="section__head">
      <h2 class="section__title" id="calendar-title">만두키우기</h2>
    </div>
    <div class="calendar">
      <div class="calendar__scroll">
        <div class="calendar__inner" style={`--weeks:${calendar.weeks.length}`}>
          <div class="calendar__months" aria-hidden="true">
            {
              calendar.months.map((month) => (
                <span class="calendar__month" style={`grid-column: ${month.index + 1} / span ${month.span}`}>
                  {month.label}
                </span>
              ))
            }
          </div>
          <div
            class="calendar__grid"
            role="group"
            aria-label={`${calendar.windowLabel} 동안 ${calendar.activeDays}일에 ${calendar.total}편 읽음`}
            data-calendar
          >
            {
              calendarDays.map((day) =>
                day.future ? (
                  <span class="calendar__cell calendar__cell--future" aria-hidden="true" />
                ) : (
                  <button
                    type="button"
                    tabindex="-1"
                    class={`calendar__cell calendar__cell--l${day.level}`}
                    data-date={day.date}
                    data-titles={JSON.stringify(day.titles)}
                    title={`${day.date} · ${day.count > 0 ? `${day.count}편 읽음` : '읽은 글 없음'}`}
                    aria-label={`${day.date} · ${day.count > 0 ? `${day.count}편 읽음` : '읽은 글 없음'}`}
                  >
                    {day.count > 0 && <span class="calendar__dumpling" aria-hidden="true">🥟</span>}
                  </button>
                ),
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const grid = document.querySelector<HTMLElement>('[data-calendar]');
  const scroller = grid?.closest<HTMLElement>('.calendar__scroll');

  // 좁은 화면에서는 최근 날짜가 먼저 보이도록 오른쪽 끝으로 맞춰 둔다.
  if (grid && scroller && scroller.scrollWidth > scroller.clientWidth) {
    scroller.scrollLeft = scroller.scrollWidth;
  }

  if (grid) {
    grid.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const cell = target?.closest<HTMLElement>('[data-date]');
      if (!cell) return;

      grid.querySelectorAll('.is-active').forEach((element) => element.classList.remove('is-active'));
      cell.classList.add('is-active');
    });
  }
</script>
