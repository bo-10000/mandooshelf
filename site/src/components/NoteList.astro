---
import type { Note } from '../lib/notes';

interface Props {
  notes: Note[];
  showCategory?: boolean;
  emptyTitle?: string;
  emptyText?: string;
}

const {
  notes,
  showCategory = false,
  emptyTitle = '글이 없어요',
  emptyText = '이 카테고리에 아직 모인 글이 없습니다.',
} = Astro.props;
---

<ul class="note-list" data-note-list>
  {
    notes.map((note) => (
      <li
        class="note-item"
        data-note
        data-status={note.isRead ? 'read' : 'unread'}
        data-category={note.category}
        data-tags={note.tags.join('|').toLowerCase()}
        data-year={note.year ?? ''}
        data-published={note.published?.sort ?? ''}
        data-search={note.search}
      >
        <a class="note-card" href={note.href}>
          <div class="note-card__top">
            {showCategory && <span class="badge badge--category">{note.categoryTitle}</span>}
            {note.isRead ? (
              <span class="badge badge--read">
                <span class="badge__dot" aria-hidden="true" />
                읽음
              </span>
            ) : (
              <span class="badge badge--unread">
                <span class="badge__dot" aria-hidden="true" />
                안 읽음
              </span>
            )}
          </div>
          <h3 class="note-card__title">{note.title}</h3>
          <div class="note-card__meta">
            {note.source && <span>{note.source}</span>}
            {note.source && note.published && <span class="dot" aria-hidden="true" />}
            {note.published && <span>{note.published.label}</span>}
            {note.isRead && note.readAt && (
              <>
                <span class="dot" aria-hidden="true" />
                <span>읽음 {note.readAt.label}</span>
              </>
            )}
          </div>
          {note.tags.length > 0 && (
            <div class="note-card__tags">
              {note.tags.slice(0, 4).map((tag) => (
                <span class="tag">{tag}</span>
              ))}
              {note.tags.length > 4 && <span class="tag tag--more">+{note.tags.length - 4}</span>}
            </div>
          )}
        </a>
      </li>
    ))
  }
</ul>

<p class="empty" data-note-empty hidden={notes.length > 0}>
  <strong>{emptyTitle}</strong>
  {emptyText}
</p>
