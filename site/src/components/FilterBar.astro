---
import { totalSummary, type CategorySummary, type Note } from '../lib/notes';

interface Props {
  notes: Note[];
  categories: CategorySummary[];
  sources: { source: string; count: number }[];
  tags: { tag: string; count: number }[];
}

const { notes, categories, sources, tags } = Astro.props;
const counts = totalSummary(notes);

/** 처음에 펼쳐 보여 줄 태그 수 */
const VISIBLE_TAGS = 12;
---

<div class="filter" data-filter-root>
  <div class="filter__row filter__row--search">
    <form class="filter__search-form" data-search-form role="search">
      <div class="filter__search">
        <input type="search" data-search aria-label="검색" placeholder="검색" autocomplete="off" enterkeyhint="search" />
        <button class="filter__clear" type="button" data-search-clear aria-label="검색어 지우기" title="검색어 지우기" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
            <path d="M7 7l10 10M17 7L7 17"></path>
          </svg>
        </button>
      </div>
      <button class="filter__submit" type="submit" data-search-submit aria-label="검색">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </button>
    </form>

    <button class="filter__toggle" type="button" data-filter-toggle aria-expanded="false" aria-controls="filter-panel">
      필터<span class="filter__toggle-count" data-filter-toggle-count hidden></span>
    </button>
  </div>

  <div class="filter__active" data-active-filters hidden></div>

  <div class="filter__panel" id="filter-panel" data-filter-panel hidden>
    <div class="filter__row">
      <div class="segmented segmented--scroll" role="group" aria-label="카테고리 필터">
        <button class="segmented__button" type="button" data-category="all" aria-pressed="true">
          전체<span class="segmented__count">{counts.total}</span>
        </button>
        {
          categories.map((category) => (
            <button class="segmented__button" type="button" data-category={category.id} aria-pressed="false">
              {category.title}
              <span class="segmented__count">{category.total}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="filter__row">
      <div class="segmented" role="group" aria-label="읽음 상태 필터">
        <button class="segmented__button" type="button" data-status="all" aria-pressed="true">
          전체<span class="segmented__count">{counts.total}</span>
        </button>
        <button class="segmented__button" type="button" data-status="unread" aria-pressed="false">
          안 읽음<span class="segmented__count">{counts.unread}</span>
        </button>
        <button class="segmented__button" type="button" data-status="read" aria-pressed="false">
          읽음<span class="segmented__count">{counts.read}</span>
        </button>
      </div>
    </div>

    {
      sources.length > 1 && (
        <div class="filter__row" data-source-row>
          <div class="segmented segmented--scroll" role="group" aria-label="출처 필터" data-source-list>
            <button class="segmented__button" type="button" data-source="all" aria-pressed="true">
              전체<span class="segmented__count" data-source-count>{counts.total}</span>
            </button>
            {sources.map(({ source, count }) => (
              <button class="segmented__button" type="button" data-source={source} aria-pressed="false">
                {source}
                <span class="segmented__count" data-source-count>
                  {count}
                </span>
              </button>
            ))}
          </div>
        </div>
      )
    }

    {
      tags.length > 0 && (
        <div class="filter__row filter__row--tags" data-tag-row>
          <ul class="tag-filter" role="group" aria-label="태그 필터" data-tag-list data-tag-limit={VISIBLE_TAGS}>
            {tags.map(({ tag, count }, index) => (
              <li hidden={index >= VISIBLE_TAGS}>
                <button
                  class="tag-chip"
                  type="button"
                  data-tag={tag}
                  aria-pressed="false"
                  title={`${tag} · ${count}개`}
                >
                  {tag}
                  <span class="tag-chip__count" data-tag-count aria-hidden="true">
                    {count}
                  </span>
                  <span class="tag-chip__x" aria-hidden="true">
                    ×
                  </span>
                </button>
              </li>
            ))}
            {tags.length > VISIBLE_TAGS && (
              <li>
                <button class="tag-chip tag-chip--more" type="button" data-tag-toggle aria-expanded="false">
                  태그 더 보기 +{tags.length - VISIBLE_TAGS}
                </button>
              </li>
            )}
            <li hidden>
              <button class="tag-chip tag-chip--clear" type="button" data-clear-tags hidden>
                태그 선택 해제
              </button>
            </li>
          </ul>
        </div>
      )
    }
  </div>

  <div class="filter__foot">
    <span aria-live="polite"><span data-visible-count>{counts.total}</span>개</span>
    <span class="filter__foot-actions">
      <select class="select" data-sort aria-label="정렬">
        <option value="published-desc">발행일 최신순</option>
        <option value="published-asc">발행일 오래된순</option>
        <option value="year-desc">연도 최신순</option>
        <option value="title">제목 가나다순</option>
      </select>
    </span>
  </div>
</div>

<script>
  import '../scripts/notes-filter';
</script>
